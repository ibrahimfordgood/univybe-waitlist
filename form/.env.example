# Copy this file to form/.env and fill in your values. Never commit form/.env
ADMIN_PASSWORD=change-me

# Neon Postgres connection string (Neon dashboard -> Connect). Leave empty to store sign-ups in form/data instead.
# On Vercel, set these in Project -> Settings -> Environment Variables (the Neon integration adds DATABASE_URL for you).
DATABASE_URL=

PORT=3000
SESSION_HOURS=12
# Set to true when serving over HTTPS (automatic on Vercel)
SECURE_COOKIES=false
